# Copy to .env (git ignores it) and fill in. On Vercel, add these as environment variables instead.
DJANGO_SECRET_KEY=
# From themoviedb.org: Settings > API. Set one of the two; the read token is preferred.
TMDB_READ_TOKEN=
TMDB_API_KEY=
# Postgres for saved profiles. Leave unset locally to use db.sqlite3. On Vercel, the Neon
# integration sets it; use the pooled URL (its host ends in -pooler).
DATABASE_URL=
# Google sign-in: an OAuth client ("Web application") from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
